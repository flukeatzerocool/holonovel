#!/usr/bin/env bash
# commit-msg — gate: reject a subject that is not the dated session form.
#
# Role: git commit-msg gate. The subject must read `YYYY-MM-DD — <title>`,
# stay within 120 characters, and not end in a period. Merge and revert
# subjects are generated by git and are left alone.
#
# Client-side hooks are fast feedback, not a guarantee: `git commit
# --no-verify` bypasses this. The durable check is the CHANGELOG-derived
# subject in `npm run session:close` and the pipeline commit step.
#
# Exit codes: 0 = pass, 1 = subject rejected, 2 = fatal.
set -euo pipefail

if [[ $# -lt 1 ]]; then
    printf 'commit-msg: commit message file required\n' >&2
    exit 2
fi

msg_file="$1"
subject=$(head -n 1 "$msg_file" 2>/dev/null || true)

# Merge and revert subjects are generated by git; leave them alone.
case "$subject" in
    Merge\ *|Revert\ *|"") exit 0 ;;
esac

if [[ "$subject" == "## "* ]]; then
    printf 'commit-msg: strip the leading "## " (the CHANGELOG marker is not part of the subject).\n' >&2
    printf '  %s\n' "$subject" >&2
    exit 1
fi

if [[ ! "$subject" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ —\ .+$ ]]; then
    printf 'commit-msg: subject must read "YYYY-MM-DD — <title>".\n' >&2
    printf '  %s\n' "$subject" >&2
    exit 1
fi

if (( ${#subject} > 120 )); then
    printf 'commit-msg: subject is %d characters (max 120).\n' "${#subject}" >&2
    printf '  %s\n' "$subject" >&2
    exit 1
fi

if [[ "$subject" == *. ]]; then
    printf 'commit-msg: subject must not end with a period.\n' >&2
    printf '  %s\n' "$subject" >&2
    exit 1
fi

exit 0
