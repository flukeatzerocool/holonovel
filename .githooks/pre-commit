#!/usr/bin/env bash
# pre-commit — run the fast structural gates before commit. [gate]
#
# Role: git pre-commit gate. Blocks the commit (exit 1) when assembly, the fast
# gate suite, or the guarded-rule-change check fails. Exit codes: 0 = all pass,
# 1 = a gate failed.
#
# The gate pass is recorded in .holonovel-state/gate-run.json keyed by HEAD and
# the working-tree signature. A commit that follows a matching pass skips the
# suite instead of running it twice; a failed or partial run writes nothing, so
# the hook falls back to the full set. This replaces the old
# HOLONOVEL_PIPELINE_GATES environment marker, which was process-local and left
# no trace after the fact.
set -euo pipefail

if ! command -v node >/dev/null 2>&1; then
    echo "ERROR: node is required to run pre-commit checks but was not found in PATH"
    exit 1
fi

echo "Running pre-commit checks..."

# Local, gitignored telemetry: the loop audit reads it to measure hook skips
# instead of assuming bypass behaviour.
log_hook_event() {
    mkdir -p .holonovel-state
    printf '{"at":"%s","event":"pre-commit","action":"%s","suite":"%s"}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "${2:-}" >> .holonovel-state/hook-events.jsonl
}

recorded=$(npx tsx scripts/run-gates.ts --recorded)

# Deprecated bridge for the legacy engine; see .githooks/pre-push.
if [ -n "${HOLONOVEL_PIPELINE_GATES:-}" ]; then
    recorded="${HOLONOVEL_PIPELINE_GATES}"
fi

case "$recorded" in
    fast*|full*)
        log_hook_event skipped "$recorded"
        echo "  (gate suite '${recorded}' already passed on this exact tree — skipping its covered steps)"
        ;;
    *)
        log_hook_event ran "fast"
        echo "  assembly..."
        npm run assemble
        echo "  fast gate suite..."
        npx tsx scripts/run-gates.ts --fast --record || {
            echo ""
            echo "BLOCKED: the fast gate suite failed — see the gate output above."
            echo ""
            exit 1
        }
        ;;
esac

echo "  guarded-rule-change check..."
npx tsx scripts/check-guarded-rule-change.ts
