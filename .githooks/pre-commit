#!/usr/bin/env bash
# pre-commit — run the fast structural gates before commit. [gate]
#
# Role: git pre-commit gate. Blocks the commit (exit 1) when assembly, version
# sync, delta reporting, the guarded-rule-change check, fingerprint sync, lint,
# or the README guardrail fails. Exit codes: 0 = all pass, 1 = a gate failed.
set -euo pipefail

if ! command -v node >/dev/null 2>&1; then
    echo "ERROR: node is required to run pre-commit checks but was not found in PATH"
    exit 1
fi

echo "Running pre-commit checks..."
# When invoked by scripts/push-pipeline.sh, HOLONOVEL_PIPELINE_GATES names the
# gate pass that actually ran (full = build-order's check, fast = the docs-only
# fallback), so only the guarded-rule-change check (unique to this hook) still
# needs to run. An absent marker — including a failed build-order that never
# wrote its run record — runs the full set.
if [[ "${HOLONOVEL_PIPELINE_GATES:-}" == "full" || "${HOLONOVEL_PIPELINE_GATES:-}" == "fast" ]]; then
    echo "  (push pipeline ran the ${HOLONOVEL_PIPELINE_GATES} gate set — running the unique guarded-rule-change check)"
else
    npm run assemble
    npx tsx scripts/version-check.ts
    npx tsx scripts/spec-delta.ts --report-only
    npm run check-fingerprint-sync
    npm run check-tool-definitions-sync
    npm run tool-definitions-lint
    npm run tool-citation-check
    npm run lint && npm run validate-readme
fi
npx tsx scripts/check-guarded-rule-change.ts
