#!/bin/sh
set -e

if ! command -v node >/dev/null 2>&1; then
    echo "ERROR: node is required to run pre-push checks but was not found in PATH"
    exit 1
fi

echo "Running pre-push checks..."

echo "  version sync..."
npx tsx scripts/version-check.ts

echo "  spec/server sync..."
spec_result=$(npx tsx scripts/spec-delta.ts 2>&1)
spec_exit=$?
echo "$spec_result" | grep -vE "^\{|^\s|\}"

if [ $spec_exit -ne 0 ]; then
    echo ""
    echo "BLOCKED: The spec (holonovel.md) has changed since the last server sync."
    echo "The holonovel server must be updated to match the current spec."
    echo ""
    echo "To fix: run the push pipeline."
    echo "  ./scripts/push-pipeline.sh"
    echo ""
    exit 1
fi

echo "  spec checks (lint, validate, audit, scan)..."
npm run check

echo "Pre-push checks passed."
