#!/usr/bin/env bash
# pre-push — run the publication gates before any push. [gate]
#
# Role: git pre-push gate. Blocks the push (exit 1) when the pending-update
# gate, spec/server sync, the check suite, or the implementation-coverage
# strict gate fails. Exit codes: 0 = all gates pass, 1 = a gate failed.
#
# Skipping is decided by the recorded gate run (.holonovel-state/gate-run.json),
# not by an environment variable. `full` means the check suite already ran on
# this tree; `+publish` means the publication gates (pending-update,
# propagation, server harnesses) ran too. Either way a failed run records
# nothing, so a direct push always runs the full set.
set -euo pipefail

if ! command -v node >/dev/null 2>&1; then
    echo "ERROR: node is required to run pre-push checks but was not found in PATH"
    exit 1
fi

echo "Running pre-push checks..."

log_hook_event() {
    mkdir -p .holonovel-state
    printf '{"at":"%s","event":"pre-push","action":"%s","suite":"%s"}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "${2:-}" >> .holonovel-state/hook-events.jsonl
}

recorded=$(npx tsx scripts/run-gates.ts --recorded)

# Deprecated bridge: the legacy engine (scripts/push-pipeline-legacy.sh) still
# exports HOLONOVEL_PIPELINE_GATES. The run manifest supersedes it for the
# step-registry engine; remove this block when the legacy engine is deleted.
if [ -n "${HOLONOVEL_PIPELINE_GATES:-}" ]; then
    recorded="${HOLONOVEL_PIPELINE_GATES}+publish"
fi

if [ "$recorded" = "none" ]; then
    log_hook_event ran "full"
else
    log_hook_event skipped "$recorded"
fi

suite_ran=false
publish_ran=false
# Only a full check lets pre-push skip the full check: a fast pass is a subset.
case "$recorded" in
    full*) suite_ran=true ;;
esac
case "$recorded" in
    *+publish) publish_ran=true ;;
esac

echo "  version sync..."
npx tsx scripts/version-check.ts

if [ "$publish_ran" = true ]; then
    echo "  (publication gates already ran on this tree — skipping pending-update, propagation, and harnesses)"
else
    echo "  pending-update gate..."
    spec_hash=$(npx tsx scripts/spec-hash.ts)
    # Capture stdout (JSON) separately from stderr (the human summary): merging
    # them with 2>&1 leaves trailing text that JSON.parse rejects, blocking every
    # push. Parse the first balanced JSON object instead.
    delta_err=$(mktemp)
    if ! raw_delta=$(npx tsx scripts/spec-delta.ts --server holonovel --report-only 2>"$delta_err"); then
        echo ""
        echo "BLOCKED: spec-delta failed — cannot classify the pending update."
        cat "$delta_err"
        echo ""
        rm -f "$delta_err"
        exit 1
    fi
    rm -f "$delta_err"
    if ! delta_class=$(node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{const i=s.indexOf('{'),j=s.lastIndexOf('}');try{const c=JSON.parse(s.slice(i,j+1)).classification;console.log(c==='none'?'patch':c)}catch{process.exit(1)}})" <<<"$raw_delta"); then
        echo ""
        echo "BLOCKED: spec-delta output could not be parsed — cannot classify the pending update."
        echo "$raw_delta"
        echo ""
        exit 1
    fi
    if ! npx tsx scripts/update-server.ts --server holonovel --spec-hash "$spec_hash" --delta-class "$delta_class" --check >/dev/null 2>&1; then
        echo ""
        echo "BLOCKED: A spec update is pending — the implementation has not been updated to match the spec."
        echo "To fix: run the push pipeline (or the opencode Update workflow first)."
        echo "  ./scripts/push-pipeline.sh"
        echo ""
        exit 1
    fi

    echo "  spec/server sync..."
    # `spec_hash` was computed above; reuse it for the root comparison instead of
    # spawning a second identical hash process.
    root_spec_hash="$spec_hash"
    embedded_spec_hash=$(npx tsx scripts/spec-hash.ts --file holonovel/holonovel.md)

    if [ "$root_spec_hash" != "$embedded_spec_hash" ]; then
        echo ""
        echo "BLOCKED: The assembled spec (holonovel.md) does not match the embedded server copy"
        echo "(holonovel/holonovel.md). The spec has not been propagated to the server."
        echo ""
        echo "To fix: run the push pipeline (propagate step)."
        echo "  ./scripts/push-pipeline.sh"
        echo ""
        exit 1
    fi

    if [ "$suite_ran" = true ]; then
        echo "  (check suite already ran on this tree — skipping)"
    else
        echo "  spec checks (lint, validate, audit, scan)..."
        npm run check

        echo "  server tool-definition + security harnesses..."
        (cd holonovel && npm run test:tool-definitions && npm run test:security) || {
            echo ""
            echo "BLOCKED: server tool-definition/security harnesses failed."
            echo "Fix the tool surface or annotations, then re-run."
            echo ""
            exit 1
        }

        echo "  holosuite evidence + deterministic tiers (evidence + conformance + invariants + novel + adversarial + differential)..."
        (cd holonovel && npm run test:holosuite-evidence && npm run test:holosuite-conformance && npm run test:holosuite-invariants && npm run test:holosuite-novel && npm run test:holosuite-adversarial && npm run test:holosuite-differential) || {
            echo ""
            echo "BLOCKED: holosuite deterministic tiers failed."
            echo "Fix the registry/annotations or the invariant/adversarial/differential breach, then re-run."
            echo ""
            exit 1
        }
    fi
fi

if [ "$suite_ran" = true ]; then
    echo "  implementation-coverage strict gate: covered by the recorded check suite"
else
    echo "  implementation-coverage strict gate..."
    npm run validate:sdd -- --impl-audit=strict || {
        echo ""
        echo "BLOCKED: implementation-coverage strict gate failed — bucket-A (gap) REQs present."
        echo "Every server-runtime REQ must be evidenced (C) or builder-side (E) before push."
        echo ""
        exit 1
    }
fi

echo "Pre-push checks passed."
