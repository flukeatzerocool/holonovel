{
  "name": "holonovel",
  "version": "2026.10.02",
  "description": "Holonovel MCP server — world-model base for tabletop RPG play. Provides core scaffold (state management, badge gating, macros, Ruleset Wisdom) and world-model layer (rooms, things, exits, parser commands, kind hierarchy). Consumed by TTRPG servers as a build-time dependency.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "holonovel": "bin/holonovel.js"
  },
  "mcpName": "io.github.flukeatzerocool/holonovel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flukeatzerocool/holonovel.git"
  },
  "files": [
    "dist",
    "bin"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js",
    "./world": "./dist/world/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:workflow": "tsx scripts/test-workflow.ts",
    "test:character-creation": "tsx scripts/test-character-creation.ts",
    "test:fingerprints": "tsx scripts/test-fingerprints.ts",
    "test:output-contracts": "tsx scripts/test-output-contracts.ts",
    "test:pattern-buffer": "tsx scripts/run_pattern_buffer.ts",
    "test:pattern-buffer-ruleset": "tsx scripts/run_ruleset_pattern_buffer.ts",
    "test:backfill": "tsx scripts/test-backfill.ts",
    "test:persistence": "tsx scripts/test-persistence.ts",
    "test:persistence-guardrails": "tsx scripts/test-persistence-guardrails.ts",
    "test:limits": "tsx scripts/test-limits.ts",
    "test:narrative": "tsx scripts/test-narrative.ts",
    "test:adventure": "tsx scripts/test-adventure.ts",
    "test:g7": "tsx scripts/test-g7.ts",
    "test:tool-definitions": "tsx scripts/test-tool-definitions.ts",
    "test:competitive-gaps": "tsx scripts/test-competitive-gaps.ts",
    "test:fate": "tsx scripts/test-fate.ts",
    "test:ironsworn": "tsx scripts/test-ironsworn.ts",
    "test:forged": "tsx scripts/test-forged.ts",
    "test:security": "tsx scripts/test-security.ts",
    "test:event-log": "tsx scripts/test-event-log.ts",
    "test:belief": "tsx scripts/test-belief.ts",
    "test:identity": "tsx scripts/test-identity.ts",
    "test:causal": "tsx scripts/test-causal.ts",
    "test:corpus": "tsx scripts/test-corpus.ts",
    "test:index": "tsx scripts/test-index.ts",
    "test:graph": "tsx scripts/test-graph.ts",
    "test:supplementary": "tsx scripts/test-supplementary.ts",
    "test:agent": "tsx scripts/test-agent.ts",
    "test:perception": "tsx scripts/test-perception.ts",
    "test:briefing": "tsx scripts/test-briefing.ts",
    "test:help": "tsx scripts/test-help.ts",
    "check:vendor": "tsx scripts/check-vendor-manifest.ts --strict",
    "check:conversion-evidence": "tsx scripts/check-conversion-evidence.ts --strict",
    "test:update-workflow": "tsx scripts/test-update-workflow.ts",
    "test:harness-guard": "tsx scripts/test-harness-guard.ts",
    "test:lean-narrator": "tsx scripts/test-lean-narrator.ts",
    "score:tools": "tsx scripts/score-tool-definitions.ts",
    "test:all": "tsx scripts/run-test-suite.ts",
    "test:playtest": "tsx scripts/playtest.ts",
    "test:playtest-lib": "tsx scripts/test-playtest.ts",
    "test:holosuite-conformance": "tsx scripts/holosuite.ts --tier=conformance",
    "test:holosuite-invariants": "tsx scripts/holosuite.ts --tier=invariants",
    "test:holosuite-adversarial": "tsx scripts/holosuite.ts --tier=adversarial",
    "test:holosuite-differential": "tsx scripts/holosuite.ts --tier=differential"
  },
  "keywords": [
    "parser",
    "world-model",
    "interactive-fiction",
    "mcp",
    "holonovel"
  ],
  "author": "Holonovel",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
