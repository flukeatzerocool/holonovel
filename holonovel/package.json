{
  "name": "holonovel",
  "version": "2026.09.04",
  "description": "Holonovel MCP server — world-model base for tabletop RPG play. Provides core scaffold (state management, badge gating, macros, enrichment) and world-model layer (rooms, things, exits, parser commands, kind hierarchy). Consumed by TTRPG servers as a build-time dependency.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "holonovel": "bin/holonovel.js"
  },
  "mcpName": "io.github.flukeatzerocool/holonovel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flukeatzerocool/holonovel.git"
  },
  "files": [
    "dist",
    "bin"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/index.js",
    "./world": "./dist/world/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:workflow": "tsx scripts/test-workflow.ts",
    "test:character-creation": "tsx scripts/test-character-creation.ts",
    "test:fingerprints": "tsx scripts/test-fingerprints.ts",
    "test:output-contracts": "tsx scripts/test-output-contracts.ts",
    "test:gauntlet": "tsx scripts/run_gauntlet.ts",
    "test:backfill": "tsx scripts/test-backfill.ts",
    "test:persistence": "tsx scripts/test-persistence.ts",
    "test:persistence-guardrails": "tsx scripts/test-persistence-guardrails.ts",
    "test:narrative": "tsx scripts/test-narrative.ts",
    "test:adventure": "tsx scripts/test-adventure.ts",
    "test:g7": "tsx scripts/test-g7.ts",
    "test:tool-definitions": "tsx scripts/test-tool-definitions.ts",
    "test:competitive-gaps": "tsx scripts/test-competitive-gaps.ts",
    "test:all": "npm run test:workflow && npm run test:character-creation && npm run test:fingerprints && npm run test:output-contracts && npm run test:gauntlet && npm run test:backfill && npm run test:persistence && npm run test:persistence-guardrails && npm run test:narrative && npm run test:adventure && npm run test:g7 && npm run test:tool-definitions && npm run test:competitive-gaps"
  },
  "keywords": [
    "inform",
    "world-model",
    "interactive-fiction",
    "mcp",
    "holonovel"
  ],
  "author": "Holonovel",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
