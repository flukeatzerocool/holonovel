{
  "name": "holonovel-spec",
  "version": "2026.09.26",
  "description": "Build specification for TTRPG MCP game servers with convergence-loop quality enforcement and job-gated pre-build configuration.",
  "main": "index.js",
  "scripts": {
    "lint": "markdownlint holonovel.md README.md",
    "validate": "npx tsx scripts/validate.ts",
    "validate:sdd": "npx tsx scripts/validate.ts --sdd-strict",
    "validate:traceability": "npx tsx scripts/validate.ts --traceability",
    "validate:quick": "npx tsx scripts/validate.ts --sdd-strict --quick",
    "validate:fast": "npx tsx scripts/validate.ts --sdd-strict --quick --no-proofread",
    "fmea": "npx tsx scripts/fmea.ts",
    "graph-deps": "npx tsx scripts/graph-deps.ts",
    "typecheck": "npx tsc --noEmit",
    "validate-readme": "npx tsx scripts/validate-readme.ts",
    "detect-dupes": "npx tsx scripts/detect-near-dupes.ts",
    "check-traceability": "npx tsx scripts/check-traceability.ts",
    "check-script-discipline": "npx tsx scripts/check-script-discipline.ts",
    "check-fingerprint-sync": "npx tsx scripts/check-fingerprint-sync.ts",
    "check": "npm run lint && npm run validate:sdd && npm run validate-readme && npm run check-script-discipline && npm run check-fingerprint-sync",
    "check:fast": "npm run lint && ( npm run validate:fast & a=$!; npm run validate-readme & b=$!; npm run check-traceability & c=$!; npm run check-script-discipline & d=$!; npm run test:validators & e=$!; npm run check-fingerprint-sync & f=$!; s=0; wait $a || s=1; wait $b || s=1; wait $c || s=1; wait $d || s=1; wait $e || s=1; wait $f || s=1; exit $s )",
    "test:validators": "npx tsx scripts/test-req-checks.ts",
    "check:full": "npm run check && npm run detect-dupes",
    "assemble": "npx tsx scripts/assemble.ts",
    "build-ruleset": "npx tsx scripts/build-ruleset.ts",
    "update-rulesets": "npx tsx scripts/update-rulesets.ts",
    "migrate-user-data": "npx tsx scripts/migrate-user-data.ts",
    "build-order": "npx tsx scripts/build-order.ts",
    "spec-propagate": "npx tsx scripts/spec-propagate.ts",
    "version-bump": "npx tsx scripts/version-bump.ts",
    "version-check": "npx tsx scripts/version-check.ts",
    "refresh-properties": "npx tsx scripts/cross-property-couple.ts",
    "spec-delta": "npx tsx scripts/spec-delta.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "markdownlint-cli": "^0.49.1",
    "@types/node": "^20",
    "tsx": "^4",
    "typescript": ">=6"
  }
}
