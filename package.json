{
  "name": "holonovel-spec",
  "version": "2026.10.22",
  "description": "Build specification for TTRPG MCP game servers with convergence-loop quality enforcement and job-gated pre-build configuration.",
  "main": "index.js",
  "scripts": {
    "lint": "markdownlint holonovel.md README.md",
    "validate": "npx tsx scripts/validate.ts",
    "validate:sdd": "npx tsx scripts/validate.ts --sdd-strict",
    "validate:traceability": "npx tsx scripts/validate.ts --traceability",
    "validate:quick": "npx tsx scripts/validate.ts --sdd-strict --quick",
    "validate:fast": "npx tsx scripts/validate.ts --sdd-strict --quick --no-proofread",
    "fmea": "npx tsx scripts/fmea.ts",
    "graph-deps": "npx tsx scripts/graph-deps.ts",
    "typecheck": "npx tsc --noEmit",
    "validate-readme": "npx tsx scripts/validate-readme.ts",
    "detect-dupes": "npx tsx scripts/detect-near-dupes.ts",
    "action-conflicts": "npx tsx scripts/action-conflicts.ts",
    "check-traceability": "npx tsx scripts/check-traceability.ts",
    "check-script-discipline": "npx tsx scripts/check-script-discipline.ts",
    "check-script-quality": "npx tsx scripts/check-script-quality.ts",
    "test:script-tooling": "npx tsx scripts/test-script-tooling.ts",
    "check-workflows": "npx tsx scripts/check-workflows.ts",
    "check-fingerprint-sync": "npx tsx scripts/check-fingerprint-sync.ts",
    "check-markers": "npx tsx scripts/cross-property-couple.ts --check",
    "spec-update-record": "npx tsx scripts/spec-update-record.ts",
    "check-registers": "npx tsx scripts/check-registers.ts",
    "check-guarded-rule-change": "npx tsx scripts/check-guarded-rule-change.ts",
    "check-registers:strict": "npx tsx scripts/check-registers.ts --strict",
    "check-tool-definitions-sync": "npx tsx holonovel/scripts/generate-tool-definitions.ts --check",
    "tool-definitions-lint": "npx tsx scripts/tool-definitions-lint.ts",
    "check-tool-surface": "npx tsx scripts/check-tool-surface.ts",
    "surface-budget": "npx tsx scripts/surface-budget.ts",
    "surface-replay": "npx tsx scripts/surface-replay.ts",
    "check-ruleset-package": "npx tsx scripts/check-ruleset-package.ts",
    "check-ruleset-model": "npx tsx scripts/check-ruleset-model.ts",
    "check-reference-server-cleanliness": "npx tsx scripts/check-reference-server-cleanliness.ts",
    "check-starter-freshness": "npx tsx holonovel/scripts/check-starter-freshness.ts",
    "test:world-provider": "npx tsx holonovel/scripts/test-world-provider.ts",
    "generate-world-provider": "npx tsx holonovel/scripts/generate-world-provider.ts",
    "check-world-provider": "npx tsx holonovel/scripts/generate-world-provider.ts --check",
    "test:ruleset-gates": "npx tsx holonovel/scripts/test-ruleset-gates.ts",
    "tool-citation-check": "npx tsx scripts/tool-citation-check.ts",
    "check:conformance": "npx tsx scripts/compare-spec-code.ts --gate",
    "check": "npm run gates -- --full",
    "check:fast": "npm run gates -- --fast",
    "test:validators": "npx tsx scripts/test-req-checks.ts",
    "test:spec-tooling": "npx tsx scripts/test-spec-tooling.ts",
    "check:full": "npm run check && npm run detect-dupes",
    "assemble": "npx tsx scripts/assemble.ts",
    "build-ruleset": "npx tsx scripts/build-ruleset.ts",
    "update-rulesets": "npx tsx scripts/update-rulesets.ts",
    "migrate-user-data": "npx tsx scripts/migrate-user-data.ts",
    "build-order": "npx tsx scripts/build-order.ts",
    "spec-propagate": "npx tsx scripts/spec-propagate.ts",
    "version-bump": "npx tsx scripts/version-bump.ts",
    "version-check": "npx tsx scripts/version-check.ts",
    "check-registry": "npx tsx scripts/check-registry-publish.ts",
    "refresh-properties": "npx tsx scripts/cross-property-couple.ts",
    "spec-delta": "npx tsx scripts/spec-delta.ts",
    "check-performance-record": "npx tsx scripts/check-performance-record.ts",
    "gates": "npx tsx scripts/run-gates.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.49.1",
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": ">=6"
  }
}
