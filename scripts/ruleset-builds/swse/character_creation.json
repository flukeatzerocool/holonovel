  "derived_stats": [
    {
      "key": "reflex_defense",
      "label": "Reflex Defense",
      "formula": "10 + level + ability_mod.dexterity + class_bonus.reflex",
      "section": "defenses"
    },
    {
      "key": "fortitude_defense",
      "label": "Fortitude Defense",
      "formula": "10 + level + ability_mod.constitution + class_bonus.fortitude",
      "section": "defenses"
    },
    {
      "key": "will_defense",
      "label": "Will Defense",
      "formula": "10 + level + ability_mod.wisdom + class_bonus.will",
      "section": "defenses"
    },
    {
      "key": "hit_points",
      "label": "Hit Points",
      "section": "derived",
      "formula": "class_bonus.starting_hp + (level - 1) * (floor(class_bonus.hit_die / 2) + 1 + ability_mod.constitution)"
    },
    {
      "key": "damage_threshold",
      "label": "Damage Threshold",
      "section": "derived",
      "formula": "10 + level + ability_mod.constitution + class_bonus.fortitude"
    },
    {
      "key": "force_points",
      "label": "Force Points",
      "section": "derived",
      "formula": "5 + floor(level / 2)"
    }
  ]
